{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.1.22",
  "description": "フィード読込エラーを左カラムで可視化するローカルフィードリーダー（RSS/Atom/RDF・自動判定・カテゴリ・重複整理・バックアップ対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
