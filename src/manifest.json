{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.1.31",
  "description": "未読優先ソート・YouTube検証・Copilot向け実ページ遷移に対応したローカルフィードリーダー",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
