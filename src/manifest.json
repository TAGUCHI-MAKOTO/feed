{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.1.19",
  "description": "登録済みWEBフィードを初回取得失敗から自動修復するローカルフィードリーダー（RSS/Atom/RDF・自動URL更新・カテゴリ・重複整理・バックアップ対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
