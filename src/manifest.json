{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.1.23",
  "description": "フィード取得成功後に古いエラー印を確実に解除するローカルフィードリーダー（RSS/Atom/RDF・ヘルスチェック・カテゴリ・重複整理対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
