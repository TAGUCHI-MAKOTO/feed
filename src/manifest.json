{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.2.2",
  "description": "登録フィード検索と固定登録パネルを追加したMyFeed（自動送り・本文対応重複判定・6並列更新・Copilotページ分離対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
