{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.2.1",
  "description": "全既読時の自動送りと本文対応の高精度重複判定を追加したMyFeed（6並列更新・進捗メーター・YouTube・Copilotページ分離対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
