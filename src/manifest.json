{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.1.24",
  "description": "YouTubeチャンネルURL登録と独立したカテゴリ管理に対応したローカルフィードリーダー（RSS/Atom/RDF・ヘルスチェック・重複整理対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
