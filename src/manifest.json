{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.1.20",
  "description": "旧RSSの探索候補を強化し、登録時・初回取得失敗時に自動修復するローカルフィードリーダー（RSS/Atom/RDF・URL自動更新・カテゴリ・重複整理対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
