{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.1.21",
  "description": "登録時・登録後の旧RSS自動修復を強化したローカルフィードリーダー（RSS/Atom/RDF・URL自動更新・カテゴリ・重複整理・バックアップ対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
