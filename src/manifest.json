{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.1.27",
  "description": "4Kでも見やすい従来フォルダアイコンと未分類最上部固定に対応したローカルフィードリーダー（YouTube・RSS/Atom/RDF・ヘルスチェック対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
