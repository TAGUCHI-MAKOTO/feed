{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.2.6",
  "description": "英字Google Newsキーワードを国内+海外英語から同時取得するMyFeed（登録検索・自動送り・本文重複判定・6並列更新対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
