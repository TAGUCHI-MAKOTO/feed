{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.1.18",
  "description": "登録済みRSSの自動修復に対応したローカルフィードリーダー（RSS/Atom/RDF・自動URL更新・可変サイドバー・カテゴリ・重複整理・バックアップ対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
