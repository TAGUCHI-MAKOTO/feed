{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.1.32",
  "description": "6並列フィード取得・一括保存・進捗メーターに対応した高速ローカルフィードリーダー（未読優先・YouTube・Copilotページ分離対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
