{
  "manifest_version": 3,
  "name": "MyFeed",
  "version": "0.1.16",
  "description": "RSS / Google News / Nitter RSS をまとめて読むローカルフィードリーダー（入力自動判定・表示名自動取得・可変サイドバー・サイトアイコン・バックアップ対応）",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MyFeedを開く"
  }
}
